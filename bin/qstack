#!/usr/bin/env python3
"""Check QStack and link its skills into a harness.

Usage:
  qstack check
  qstack install   [HARNESS ...] [--only a,b] [--no-system] [--dry-run]
  qstack status    HARNESS [HARNESS ...] [same target options]
  qstack uninstall HARNESS [HARNESS ...] [same target options] [--only a,b] [--no-system] [--dry-run]

HARNESS is claude, pi or antigravity. install with no names selects all three.
--home DIR or --dir DIR selects a custom target for exactly one harness.
--profile NAME selects Pi's profile, including in a multi-harness command.

A harness gets every skill in shared/ plus every skill in its own folder, each as one symlink.
Antigravity gets copies instead, because it refuses to read files that resolve outside its
skills directory. Each copy holds a .qstack-source file naming where it came from; run install
again after editing a skill to refresh the copies.

Where it installs:
  claude  HOME/skills, where HOME is --home, else $CLAUDE_CONFIG_DIR, else ~/.claude.
  pi      --profile NAME, else --home, else $PI_CODING_AGENT_DIR, else existing profiles
          under ~/.config/pi/profiles/, else ~/.pi/agent. Skills go in skills/.
  antigravity HOME/config/skills, where HOME is --home, else ~/.gemini.
              System installs and T3 Code's managed runtime use these same global skills.
  --dir   any skills directory, for any harness. Skills only.

install also adds the harness's APPEND_SYSTEM.md to the system prompt, unless --no-system or
--dir is given: for claude as the link HOME/rules/qstack.md, for pi as a marked block inside
the profile's APPEND_SYSTEM.md, for antigravity as a marked block inside HOME/GEMINI.md.
Text outside the markers is never touched.

install never replaces or removes anything that is not already a link or copy made by QStack.
Full install and uninstall (without --only) remove orphaned QStack skills with trash-put, and
status lists them as orphaned.
"""
import argparse
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
HARNESSES = ("claude", "pi", "antigravity")
SKILL_FOLDERS = ("shared", *HARNESSES)
NAME_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
LINK_RE = re.compile(r"`((?:\.\./)*[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+\.(?:md|yaml|py))`")
HARNESS_REF_RE = re.compile(r"`(harness-[a-z-]+)`")
# Antigravity's file tools reject a skill file whose real path is outside its skills directory.
COPY_HARNESSES = ("antigravity",)
MARKER = ".qstack-source"


def skills_in(folder):
    base = ROOT / folder
    return {p.name: p for p in sorted(base.iterdir()) if p.is_dir()} if base.is_dir() else {}


def frontmatter(path):
    text = path.read_text()
    if not text.startswith("---\n") or "\n---\n" not in text[4:]:
        return None
    block = text[4:text.index("\n---\n", 4)]
    fields, key = {}, None
    for line in block.splitlines():
        match = re.match(r"^([A-Za-z_-]+):\s*(.*)$", line)
        if match and not line.startswith(" "):
            key = match.group(1)
            fields[key] = match.group(2).strip()
        elif key and line.startswith(" "):
            fields[key] = (fields[key] + " " + line.strip()).strip()
    for key, value in fields.items():
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            fields[key] = value[1:-1]
    return fields


def check():
    errors = []
    shared = skills_in("shared")
    per_harness = {h: skills_in(h) for h in HARNESSES}
    for folder, skills in [("shared", shared)] + list(per_harness.items()):
        for name, path in skills.items():
            where = f"{folder}/{name}"
            skill_md = path / "SKILL.md"
            if not skill_md.is_file():
                errors.append(f"{where}: missing SKILL.md")
                continue
            for md in path.rglob("SKILL.md"):
                rel = md.relative_to(ROOT)
                fields = frontmatter(md)
                if fields is None:
                    errors.append(f"{rel}: missing frontmatter")
                    continue
                if fields.get("name") != md.parent.name:
                    errors.append(f"{rel}: name `{fields.get('name')}` does not match its folder")
                if not NAME_RE.match(fields.get("name", "")) or len(fields.get("name", "")) > 64:
                    errors.append(f"{rel}: invalid skill name")
                desc = fields.get("description", "")
                if not desc or len(desc) > 1024:
                    errors.append(f"{rel}: description must be 1-1024 characters")
                if "type: procedure" not in md.read_text() and "type: guideline" not in md.read_text():
                    errors.append(f"{rel}: metadata.type must be procedure or guideline")
    names = [set(per_harness[h]) for h in HARNESSES]
    if any(group != names[0] for group in names[1:]):
        differing = set.union(*names) - set.intersection(*names)
        errors.append(f"{', '.join(h + '/' for h in HARNESSES)} must offer the same skill names; "
                      f"differing: {sorted(differing)}")
    for h in HARNESSES:
        for clash in sorted(set(shared) & set(per_harness[h])):
            errors.append(f"`{clash}` exists in both shared/ and {h}/")
    # Links are checked in the installed view: shared and one harness as sibling directories.
    for h in HARNESSES:
        view = {**shared, **per_harness[h]}
        for name, path in view.items():
            for md in path.rglob("*.md"):
                text = md.read_text()
                for ref in HARNESS_REF_RE.findall(text):
                    if ref not in per_harness[h]:
                        errors.append(f"{md.relative_to(ROOT)}: names `{ref}`, absent from {h}/")
                for link in LINK_RE.findall(text):
                    parts = Path(link).parts
                    ups = sum(1 for part in parts if part == "..")
                    here = md.parent.relative_to(path).parts
                    if ups > len(here) + 1:
                        continue
                    if ups == len(here) + 1:
                        target_skill = parts[ups] if len(parts) > ups else ""
                        target = view.get(target_skill)
                        resolved = target.joinpath(*parts[ups + 1:]) if target else None
                    else:
                        resolved = md.parent.joinpath(*parts)
                        if not resolved.exists() and ups == 0:
                            resolved = path.joinpath(*parts)
                    if resolved is None or not resolved.exists():
                        errors.append(f"{md.relative_to(ROOT)} ({h} view): broken link `{link}`")
    for error in sorted(set(errors)):
        print(f"error: {error}")
    total = len(shared) + sum(len(v) for v in per_harness.values())
    print(f"{total} skills checked, {len(set(errors))} errors")
    return 1 if errors else 0


BEGIN, END = "<!-- qstack:begin -->", "<!-- qstack:end -->"


def harness_home(args):
    """The harness's own directory, or None when only a skills directory was given."""
    if args.dir:
        return None
    if args.harness == "claude":
        home = args.home or os.environ.get("CLAUDE_CONFIG_DIR") or "~/.claude"
        return Path(home).expanduser()
    if args.harness == "antigravity":
        # T3's private GEMINI_HOME links skills from the real ~/.gemini, not its runtime download.
        return Path(args.home or "~/.gemini").expanduser()
    return Path(args.home or "~/.pi/agent").expanduser()


def target_dir(args):
    if args.dir:
        return Path(args.dir).expanduser()
    home = harness_home(args)
    return home / "config" / "skills" if args.harness == "antigravity" else home / "skills"


def system_source(args):
    return ROOT / args.harness / "APPEND_SYSTEM.md"


def system_target(args):
    home = harness_home(args)
    if home is None:
        return None
    if args.harness == "claude":
        return home / "rules" / "qstack.md"
    return home / ("GEMINI.md" if args.harness == "antigravity" else "APPEND_SYSTEM.md")


def block(args):
    return f"{BEGIN}\n{system_source(args).read_text().strip()}\n{END}\n"


def split_block(text):
    """Return (before, block, after); block is '' when the markers are absent."""
    start, end = text.find(BEGIN), text.find(END)
    if start == -1 or end == -1 or end < start:
        return text, "", ""
    end += len(END)
    if text[end:end + 1] == "\n":
        end += 1
    return text[:start], text[start:end], text[end:]


def system_state(args):
    target = system_target(args)
    if target is None:
        return "skipped"
    if args.harness == "claude":
        return state(target, system_source(args))
    if not target.exists():
        return "missing"
    current = split_block(target.read_text())[1]
    return "missing" if not current else "linked" if current == block(args) else "stale"


def system_install(args):
    target, what = system_target(args), system_state(args)
    if what == "skipped":
        print("skipped   system prompt (not installed with --dir)")
        return 0
    label = f"system prompt -> {target}"
    if what == "linked":
        print(f"ok        {label}")
    elif what in ("conflict", "foreign-link"):
        print(f"CONFLICT  {target} exists and is not a QStack link; left untouched")
        return 1
    else:
        if not args.dry_run:
            target.parent.mkdir(parents=True, exist_ok=True)
            if args.harness == "claude":
                tmp = target.with_name(".qstack.md.qstack-tmp")
                os.symlink(system_source(args), tmp)
                os.replace(tmp, target)
            else:
                text = target.read_text() if target.exists() else ""
                before, _, after = split_block(text)
                if not _ and before and not before.endswith("\n\n"):
                    before += "\n" if before.endswith("\n") else "\n\n"
                target.write_text(before + block(args) + after)
        print(f"{'updated' if what == 'stale' else 'added':9} {label}")
    return 0


def system_uninstall(args):
    target = system_target(args)
    if target is None:
        return
    if args.harness == "claude":
        if not recorded(target, system_source(args).name):
            return
    elif system_state(args) not in ("linked", "stale"):
        return
    if not args.dry_run:
        if args.harness == "claude":
            trash(target)
        else:
            before, _, after = split_block(target.read_text())
            target.write_text(before.rstrip("\n") + ("\n" if before.strip() else "") + after)
    print(f"removed   system prompt from {target}")


def all_skills(harness):
    """Installable skills: valid NAME_RE directories holding a SKILL.md."""
    return {name: path for folder in ("shared", harness)
            for name, path in skills_in(folder).items()
            if NAME_RE.fullmatch(name) and (path / "SKILL.md").is_file()}


def selected(args):
    skills = all_skills(args.harness)
    if getattr(args, "only", None) is not None:
        wanted = [n for n in args.only.split(",") if n]
        if not wanted:
            sys.exit("qstack: --only requires at least one skill name")
        unknown = [n for n in wanted if n not in skills]
        if unknown:
            sys.exit(f"qstack: unknown skills for {args.harness}: {', '.join(unknown)}")
        skills = {n: skills[n] for n in wanted}
    return skills


def tree(path):
    """Every file under path, relative path to bytes, without the QStack marker."""
    return {str(f.relative_to(path)): f.read_bytes() for f in sorted(path.rglob("*"))
            if f.is_file() and f.name != MARKER}


def recorded(path, name):
    """The ROOT/<folder>/<name> that QStack recorded at path, or None."""
    slots = [ROOT / folder / name for folder in SKILL_FOLDERS]
    try:
        if path.is_symlink():
            raw = os.readlink(path)
            base = None if os.path.isabs(raw) else os.path.realpath(path.parent)
            for slot in slots:
                if raw == (str(slot) if base is None else os.path.relpath(slot, base)):
                    return slot
            return None
        marker = path / MARKER
        if not path.is_dir() or not NAME_RE.fullmatch(name) or marker.is_symlink() or not marker.is_file():
            return None
        return {os.fsencode(f"{slot}\n"): slot for slot in slots}.get(marker.read_bytes())
    except OSError:
        return None


def orphans(dest, known):
    """Sorted QStack-owned entries in dest whose names are absent from known."""
    if not dest.is_dir():
        return []
    return [entry for entry in sorted(dest.iterdir())
            if entry.name not in known and NAME_RE.fullmatch(entry.name)
            and recorded(entry, entry.name)]


def state(link, source, copy=False):
    made = recorded(link, source.name)
    if link.is_symlink():
        if made:
            return "linked" if not copy and made == source and link.exists() else "stale"
        if not copy and link.exists() and os.path.realpath(link) == os.path.realpath(source):
            return "linked"
        return "foreign-link"
    if made:
        return "linked" if copy and made == source and tree(link) == tree(source) else "stale"
    return "conflict" if link.exists() else "missing"


def trash(path):
    subprocess.run(["trash-put", "--", str(path)], check=True)


def place(source, link, copy):
    """Put a fresh link or copy at link, replacing the QStack-made one there."""
    tmp = link.with_name(f".{link.name}.qstack-tmp")
    if tmp.is_symlink() or tmp.exists():
        trash(tmp)
    if not copy:
        os.symlink(source, tmp)
        if link.is_dir() and not link.is_symlink():
            trash(link)
        os.replace(tmp, link)
        return
    shutil.copytree(source, tmp)
    (tmp / MARKER).write_text(f"{source}\n")
    if link.is_symlink() or link.exists():
        trash(link)
    os.rename(tmp, link)


def remove_orphans(dest, known, dry_run):
    for orphan in orphans(dest, known):
        if not dry_run:
            trash(orphan)
        print(f"removed   {orphan.name} (orphaned)")


def install(args):
    dest = target_dir(args)
    copy = args.harness in COPY_HARNESSES
    skills = selected(args)
    conflicts = 0
    if not args.dry_run:
        dest.mkdir(parents=True, exist_ok=True)
    for name, source in skills.items():
        link, what = dest / name, state(dest / name, source, copy)
        if what == "linked":
            print(f"ok        {name}")
        elif what in ("missing", "stale"):
            if not args.dry_run:
                place(source, link, copy)
            verb = ("recopied" if what == "stale" else "copied") if copy else \
                ("relinked" if what == "stale" else "linked")
            print(f"{verb:9} {name} -> {source}")
        else:
            conflicts += 1
            print(f"CONFLICT  {name}: {link} exists and is not a QStack link; left untouched")
    if args.only is None:
        remove_orphans(dest, skills, args.dry_run)
        if not args.no_system:
            conflicts += system_install(args)
    if conflicts:
        print(f"{conflicts} conflicts. Move the existing copy out of its owner (chezmoi or "
              f"otherwise), then install again.")
    return 1 if conflicts else 0


def status(args):
    dest = target_dir(args)
    copy = args.harness in COPY_HARNESSES
    skills = selected(args)
    for name, source in skills.items():
        print(f"{state(dest / name, source, copy):12} {name}")
    if args.only is None:
        for orphan in orphans(dest, skills):
            print(f"{'orphaned':12} {orphan.name}")
    print(f"{system_state(args):12} system prompt")
    return 0


def uninstall(args):
    dest = target_dir(args)
    skills = selected(args)
    for name in skills:
        link = dest / name
        if recorded(link, name):
            if not args.dry_run:
                trash(link)
            print(f"removed   {name}")
    if args.only is None:
        remove_orphans(dest, skills, args.dry_run)
        if not args.no_system:
            system_uninstall(args)
    return 0


def pi_homes(args):
    profiles = Path.home() / ".config" / "pi" / "profiles"
    if args.profile:
        return [profiles / args.profile]
    home = args.home or os.environ.get("PI_CODING_AGENT_DIR")
    if home:
        return [Path(home).expanduser()]
    existing = sorted(p for p in profiles.iterdir() if p.is_dir()) if profiles.is_dir() else []
    return existing or [Path.home() / ".pi" / "agent"]


def targets(args, parser):
    harnesses = list(dict.fromkeys(args.harness or HARNESSES))
    unknown = [h for h in harnesses if h not in HARNESSES]
    if unknown:
        parser.error(f"unknown harness: {', '.join(unknown)}; choose from {', '.join(HARNESSES)}")
    for option in ("dir", "home"):
        if getattr(args, option) and len(harnesses) != 1:
            parser.error(f"--{option} requires exactly one harness")
    if args.dir and (args.home or args.profile):
        parser.error("--dir cannot be combined with --home or --profile")
    if args.home and args.profile:
        parser.error("--home cannot be combined with --profile")
    if args.profile and "pi" not in harnesses:
        parser.error("--profile requires pi")
    resolved = []
    for harness in harnesses:
        homes = pi_homes(args) if harness == "pi" and not args.dir else [args.home]
        for home in homes:
            target = argparse.Namespace(**{**vars(args), "harness": harness, "home": home})
            selected(target)  # Validate the whole batch before the first target is changed.
            resolved.append(target)
    return resolved


def main():
    parser = argparse.ArgumentParser(prog="qstack", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("check")
    for cmd in ("install", "status", "uninstall"):
        p = sub.add_parser(cmd)
        p.add_argument("harness", metavar="HARNESS", nargs="*" if cmd == "install" else "+",
                       help="claude, pi or antigravity; install defaults to all three")
        p.add_argument("--dir", help="a skills directory; skills only")
        p.add_argument("--home", help="claude: its config directory (default "
                                      "$CLAUDE_CONFIG_DIR or ~/.claude); pi: its agent directory; "
                                      "antigravity: its Gemini directory (default ~/.gemini). "
                                      "Requires exactly one harness")
        p.add_argument("--profile", help="pi: the profile name (otherwise auto-detected)")
        p.add_argument("--only", help="comma-separated skill names")
        p.add_argument("--dry-run", action="store_true")
        p.add_argument("--no-system", action="store_true",
                       help="leave the system prompt alone")
    args = parser.parse_args()
    if args.cmd == "check":
        return check()
    action = {"install": install, "status": status, "uninstall": uninstall}[args.cmd]
    result = 0
    for target in targets(args, parser):
        print(f"{target.harness}: {target_dir(target)}")
        result = max(result, action(target))
    return result


if __name__ == "__main__":
    sys.exit(main())
